# Set through the MCP client environment, or explicitly choose SAP_ENV_FILE.
SAP_URL=https://sap.example.invalid:44300
SAP_USER=YOUR_USER
SAP_PASSWORD=YOUR_PASSWORD
SAP_CLIENT=100
SAP_LANGUAGE=EN
SAP_REQUEST_TIMEOUT_MS=60000
# Set NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem before starting Node for a private CA.
# Optional alternative to password: SAP_BEARER_TOKEN from your authorized token broker.
